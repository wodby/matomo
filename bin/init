#!/usr/bin/env bash

set -e

if [[ -n "${DEBUG}" ]]; then
    set -x
fi

src_dir="/usr/src/matomo"

# Succeeds when Matomo is installed, by the rule Matomo itself applies: the
# local settings have a database user and no installation is in progress.
# Opening the web installer creates the settings file before the database is
# set up, so the file alone does not mean Matomo is installed.
matomo_installed() {
    local config="${APP_ROOT}/config/config.ini.php"

    [[ -f "${config}" ]] && php -r '
        $c = parse_ini_file($argv[1], true, INI_SCANNER_RAW) ?: [];
        exit(!empty($c["database"]["username"]) && empty($c["General"]["installation_in_progress"]) ? 0 : 1);
    ' "${config}"
}

if [[ ! -f "${APP_ROOT}/piwik.php" ]]; then
    echo >&2 "${APP_NAME} not found in ${APP_ROOT} - copying now..."
    rsync -a "${src_dir}/" "${APP_ROOT}/"
    chown www-data:www-data "${APP_ROOT}/matomo.js"
    echo >&2 "Complete! ${APP_NAME} has been successfully copied to ${APP_ROOT}"
else
    latest_ver=$(php "${src_dir}/console"  -V | grep -oE '[0-9]+(\.[0-9]+){2}')
    current_ver=$(php "${APP_ROOT}/console"  -V | grep -oE '[0-9]+(\.[0-9]+){2}')

    res=$(compare_semver "${latest_ver}" "${current_ver}" ">")

    if [[ "${res}" == 0 ]]; then
        echo "Current version of ${APP_NAME} is outdated (${current_ver}), updating to ${latest_ver}..."
        rsync -a "${src_dir}/" "${APP_ROOT}/"
        # Matomo 5 dropped files that an update from Matomo 4 leaves behind.
        # Compare major versions: a pattern such as "4." also matches 5.14.2.
        if [[ "${latest_ver%%.*}" == 5 && "${current_ver%%.*}" == 4 ]]; then
            rm -f "${APP_ROOT}/plugins/CoreConsole/Commands/GenerateAngularComponent.php" \
                "${APP_ROOT}/plugins/CoreConsole/Commands/GenerateAngularDirective.php"
            su-exec wodby php console diagnostics:unexpected-files --delete -n
        fi
        echo "Complete! ${APP_NAME} files have been updated to ${latest_ver}"
    fi

    # Update the database whenever Matomo is installed, not only right after the
    # files are updated: a run that stopped between the two steps leaves new
    # files with an old database, and the next run sees no newer version.
    # Without pending updates, this changes nothing.
    if matomo_installed; then
        su-exec wodby php console core:update --yes
    fi

    chown www-data:www-data "${APP_ROOT}/matomo.js"

    # Fix permission so a default user can customize the config.
    if [[ -f "${APP_ROOT}/config/config.ini.php" ]]; then
        chown wodby:www-data "${APP_ROOT}/config/config.ini.php";
        chmod 664 "${APP_ROOT}/config/config.ini.php";
    fi
fi
